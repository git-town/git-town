{
  "$schema": "https://github.com/kevgo/trident/raw/refs/heads/main/docs/schema.json",

  "ignore-files": ["dist/", "node_modules/", "vendor/", ".rumdl_cache/"],

  "stacks": {
    "go": {
      "fix": {
        "before": [
          {
            "name": "optioncompare in tests",
            "command": "make --no-print-directory fix-optioncompare-in-tests"
          },
          {
            "name": "format cmp_or",
            "command": "go run tools/format_cmp_or/format_cmp_or.go"
          },
          {
            "name": "format unittests",
            "command": "go run tools/format_unittests/format_unittests.go"
          },
          {
            "name": "format self",
            "command": "go run tools/format_self/format_self.go"
          },
          {
            "name": "sync RTA version",
            "command": "go run tools/sync_rta_version/sync_rta_version.go"
          },
          {
            "name": "generate JSON schema",
            "command": "make --no-print-directory generate-json-schema"
          },
          {
            "name": "generate opcodes",
            "command": "tools/generate_opcodes_all.sh"
          },
          {
            "name": "shfmt",
            "command": "tools/generate_opcodes_all.sh"
          }
        ]
      },
      "lint": {
        "add": [
          {
            "name": "lint-smoke",
            "command": "make --no-print-directory lint-smoke"
          },
          {
            "name": "alphavet",
            "command": "make --no-print-directory alphavet"
          },
          {
            "name": "deadcode",
            "command": "make --no-print-directory deadcode"
          },
          {
            "name": "staticcheck",
            "command": "tools/rta --from-source staticcheck ./..."
          },
          {
            "name": "cached connectors",
            "command": "make --no-print-directory lint-cached-connectors"
          },
          {
            "name": "collector addf",
            "command": "make --no-print-directory lint-collector-addf"
          },
          {
            "name": "iterate map",
            "command": "make --no-print-directory lint-iterate-map"
          },
          {
            "name": "messages sorted",
            "command": "make --no-print-directory lint-messages-sorted"
          },
          {
            "name": "messy output",
            "command": "make --no-print-directory lint-messy-output"
          },
          {
            "name": "optioncompare",
            "command": "make --no-print-directory lint-optioncompare"
          },
          {
            "name": "print config",
            "command": "make --no-print-directory lint-print-config"
          },
          {
            "name": "structs sorted",
            "command": "make --no-print-directory lint-structs-sorted"
          },
          {
            "name": "tests sorted",
            "command": "make --no-print-directory lint-tests-sorted"
          },
          {
            "name": "use equal",
            "command": "make --no-print-directory lint-use-equal"
          },
          {
            "name": "lint steps",
            "command": "make --no-print-directory lint-steps"
          },
          {
            "name": "no files with dashes",
            "command": "tools/ensure_no_files_with_dashes.sh"
          },
          {
            "name": "configfile",
            "command": "make --no-print-directory lint-configfile"
          }
        ]
      }
    },
    "markdown": {
      "fix": {
        "before": [
          {
            "name": "format changelog",
            "command": "dprint fmt --config dprint-changelog.json"
          }
        ]
      }
    }
  },

  "applications": {
    "keep-sorted": { "enabled": true, "ignore-files": ["Makefile"] }
  },

  "tests": [
    {
      "name": "doc",
      "command": "make --no-print-directory doc"
    },
    {
      "name": "unit",
      "command": "make --no-print-directory unit"
    }
  ]
}
