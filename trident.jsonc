{
  "$schema": "https://github.com/kevgo/trident/raw/refs/heads/main/docs/schema.json",

  "ignore-files": ["dist/", "node_modules/", "vendor/", ".rumdl_cache/"],

  "global-lints": [],
  "global-fixes": [
    {
      "name": "generate opcodes",
      "command": "tools/generate_opcodes_all.sh"
    }
  ],

  "stacks": {
    "go": {
      "fix": {
        "add": [
          {
            "name": "optioncompare in tests",
            "command": "make --no-print-directory fix-optioncompare-in-tests"
          },
          {
            "name": "format cmp_or",
            "command": "go run tools/format_cmp_or/format_cmp_or.go"
          },
          {
            "name": "format unittests",
            "command": "go run tools/format_unittests/format_unittests.go"
          },
          {
            "name": "format self",
            "command": "go run tools/format_self/format_self.go"
          },
          {
            "name": "sync RTA version",
            "command": "go run tools/sync_rta_version/sync_rta_version.go"
          }
        ]
      }
    },
    "json": {
      "fix": {
        "add": [
          {
            "name": "generate JSON schema",
            "command": "make --no-print-directory generate-json-schema"
          },
          {
            "name": "format changelog",
            "command": "dprint fmt --config dprint-changelog.json"
          }
        ]
      }
    }
  },

  "applications": {
    "keep-sorted": { "enabled": true, "ignore-files": ["Makefile"] }
  }
}
